{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LOL-SBTI 数据导出",
  "version": "0.1.0",
  "identifier": "com.lolsbti.exporter",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "LOL-SBTI 数据导出",
        "width": 520,
        "height": 500,
        "resizable": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'"
    }
  },
  "bundle": {
    "active": false
  }
}

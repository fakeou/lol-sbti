{
  "name": "lol-sbti",
  "private": true,
  "packageManager": "pnpm@9.1.2",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "format:check": "cargo fmt --check --all",
    "desktop:build": "cargo build -p lol-sbti",
